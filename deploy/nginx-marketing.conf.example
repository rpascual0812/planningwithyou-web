# Example nginx config for planningwithyou.com (marketing static site).
# Serve the Vite build output from /var/www/planningwithyou-web/dist
#
# Important for Facebook Open Graph:
# - Deploy the full dist/ folder including dist/og/*.jpg
# - OG image URLs must return Content-Type: image/jpeg (not text/html)
# - Do NOT proxy this host to the Django API

server {
    listen 443 ssl http2;
    server_name planningwithyou.com;

    root /var/www/planningwithyou-web/dist;
    index index.html;

    location = /robots.txt {
        try_files /robots.txt =404;
    }

    location = /sitemap.xml {
        try_files /sitemap.xml =404;
    }

    # OG images — must be served as static files, never SPA index.html
    location ~* ^/og/.+\.(jpe?g|png)$ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=86400";
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
